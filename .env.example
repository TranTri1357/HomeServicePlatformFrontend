# ─── Cấu hình môi trường Frontend (Vite) ───────────────────────────────
# Sao chép file này thành `.env` rồi điền giá trị thật. KHÔNG commit file `.env`.
# Mọi biến phải bắt đầu bằng tiền tố VITE_ mới được Vite expose ra client.

# Base URL của Backend API (ASP.NET Core) — LƯU Ý: có hậu tố /api ở cuối.
# Production (Render):
VITE_API_BASE_URL=https://homeserviceplatform.onrender.com/api
# Local dev (ví dụ): VITE_API_BASE_URL=https://localhost:7000/api

# URL gốc cho real-time (SignalR / WebSocket: chat, thông báo, tracking thợ).
# KHÔNG kèm /api.
VITE_WS_URL=https://homeserviceplatform.onrender.com
# Local dev (ví dụ): VITE_WS_URL=https://localhost:7000
